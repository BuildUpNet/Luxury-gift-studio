# Server Port
PORT=5002

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=gift_studio

# JWT Secret Key
JWT_SECRET=your_super_strong_jwt_secret_key_change_in_production

# Allowed Frontend Origins for CORS (comma-separated or single)
CLIENT_ORIGIN=http://localhost:5173

# Uploads Configuration
UPLOAD_DIR=../public/images
MAX_FILE_SIZE_BYTES=5242880
REQUEST_SIZE_LIMIT=2mb

# Email Configuration (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# For Gmail: Use App Password generated at: https://myaccount.google.com/apppasswords
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ADMIN_EMAIL=admin@thegiftstudio.com
EMAIL_FROM=The Gift Studio <admin@thegiftstudio.com>
