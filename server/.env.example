# Server Environment Variables Template
# Copy this file to server/.env and fill in real production credentials

# Server Port
PORT=5002

# Allowed Frontend Origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=gift_studio

# JWT Secret for Admin Authentication (use a long, cryptographically random string)
JWT_SECRET=your_jwt_secret_key_here

# SMTP / Email Configuration (for contact forms & inquiries)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password_here
ADMIN_EMAIL=your_admin_email@gmail.com
EMAIL_FROM="The Gift Studio <your_email@gmail.com>"
